# App
NODE_ENV=development
PORT=3000
LOCAL_DEV=true

# Session signing key (set your own strong random value)
SESSION_SECRET=nenkei_secret_2025

# Google OAuth credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Optional: leave empty to auto-use /auth/google/callback on current host
CALLBACK_URL=/auth/google/callback

# Spreadsheet ID for the dedicated Quotes/Bookings CRM sheet (separate from
# the Sales Register/VCM sheets in config/sheets.js). Create a blank Google
# Sheet, share it with your dealership's Google account(s), and paste its ID
# (the long string in the sheet's URL) here. Quotes/Bookings tabs and header
# rows are created automatically on first use.
CRM_SPREADSHEET_ID=
